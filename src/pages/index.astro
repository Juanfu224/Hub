---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import SocialRow from "../components/SocialRow.astro";
import TornLink from "../components/TornLink.astro";
import { getCardLinks, profile } from "../data/links";

const cardLinks = getCardLinks();
const title = `${profile.name} — Enlaces y contacto`;
---

<BaseLayout title={title}>
  <div class="lt-shell">
    <main class="lt-main">
      <Profile />
      <SocialRow />
      <nav aria-label="Enlaces" class="lt-nav">
        <ul class="lt-links">
          {
            cardLinks.map((link) => (
              <li>
                <TornLink link={link} />
              </li>
            ))
          }
        </ul>
      </nav>
    </main>
    <footer class="lt-footer">
      <p>Enlaces directos, sin trackers</p>
    </footer>
  </div>
</BaseLayout>
