---
import { getSocialLinks, iconClass } from "../data/links";

const socials = getSocialLinks();
---

{
  socials.length > 0 && (
    <ul class="lt-socials" aria-label="Contacto">
      {socials.map((link) => (
        <li>
          <a
            href={link.url}
            aria-label={link.label}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            referrerpolicy={link.external ? "no-referrer" : undefined}
          >
            <span
              class:list={["lt-social-icon", iconClass(link.icon)]}
              aria-hidden="true"
            />
          </a>
        </li>
      ))}
    </ul>
  )
}
