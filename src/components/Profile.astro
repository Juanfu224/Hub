---
import { getProfile } from "../lib/home";

const profile = (await getProfile()).data;
---

<header class="lt-profile">
  <img
    src={profile.avatar}
    alt={`Foto de perfil de ${profile.name}`}
    width="112"
    height="112"
    class="lt-avatar"
    decoding="async"
    fetchpriority="high"
  />
  <h1 class="lt-name">{profile.name}</h1>
  <p class="lt-bio">{profile.bio}</p>
</header>

<style>
  .lt-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .lt-avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    box-shadow: 0 8px 30px rgb(12 18 34 / 0.12);
    outline: 2px solid var(--lt-line);
    outline-offset: 0;
  }

  .lt-name {
    margin: 1.25rem 0 0;
    font-family: var(--lt-font-display);
    font-size: clamp(2.25rem, 5vw + 1rem, 3rem);
    font-weight: 600;
    font-optical-sizing: auto;
    line-height: 1.1;
    color: var(--lt-ink);
    letter-spacing: -0.025em;
    text-shadow: 0 1px 2px rgb(255 255 255 / 0.65);
  }

  .lt-bio {
    margin: 0.75rem 0 0;
    max-width: 22rem;
    font-family: var(--lt-font);
    font-size: 1.0625rem;
    font-weight: 400;
    line-height: 1.55;
    color: var(--lt-ink-muted);
    text-shadow: 0 1px 2px rgb(255 255 255 / 0.55);
  }
</style>
