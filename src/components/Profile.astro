---
import { profile } from "../data/links";
---

<header class="lt-profile">
  <img
    src={profile.avatar}
    alt={`Foto de perfil de ${profile.name}`}
    width="112"
    height="112"
    class="lt-avatar"
    decoding="async"
    fetchpriority="high"
  />
  <h1 class="lt-name">{profile.name}</h1>
  <p class="lt-bio">{profile.bio}</p>
</header>
