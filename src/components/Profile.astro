---
import { profile } from "../data/links";
---

<header class="animate-rise flex flex-col items-center text-center">
  <img
    src={profile.avatar}
    alt={`Foto de perfil de ${profile.name}`}
    width="112"
    height="112"
    class="size-28 rounded-full object-cover ring-2 ring-[var(--color-line)] shadow-[0_8px_30px_rgb(12_18_34_/_0.12)]"
    decoding="async"
    fetchpriority="high"
  />
  <h1
    class="mt-5 font-display text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl"
  >
    {profile.name}
  </h1>
  <p class="mt-3 max-w-sm text-base leading-relaxed text-[var(--color-ink-muted)] sm:text-lg">
    {profile.bio}
  </p>
</header>
