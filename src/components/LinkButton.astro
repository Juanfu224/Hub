---
import type { SocialLink } from "../data/links";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  link: SocialLink;
}

const { link } = Astro.props;
const externalAttrs = link.external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a
  href={link.url}
  class:list={[
    "group flex min-h-12 w-full items-center gap-3 rounded-xl px-4 py-3.5",
    "border border-[var(--color-line)] bg-white/70 backdrop-blur-sm",
    "text-[var(--color-ink)] no-underline transition duration-200",
    "hover:-translate-y-0.5 hover:border-[var(--color-accent)] hover:bg-white hover:shadow-[0_10px_28px_rgb(12_18_34_/_0.08)]",
    "active:translate-y-0",
  ]}
  {...externalAttrs}
>
  <span
    class="flex size-9 items-center justify-center rounded-lg bg-[var(--color-surface)] text-[var(--color-accent)] transition group-hover:bg-[var(--color-accent)] group-hover:text-white"
  >
    <SocialIcon icon={link.icon} class="size-5" />
  </span>
  <span class="flex-1 text-left text-base font-medium tracking-tight">{link.label}</span>
  <span
    class="text-[var(--color-ink-muted)] transition group-hover:translate-x-0.5 group-hover:text-[var(--color-accent)]"
    aria-hidden="true"
  >
    →
  </span>
</a>
